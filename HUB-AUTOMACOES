    local streaming_domains=("netflix.com" "www.netflix.com" "youtube.com" "www.youtube.com" "primevideo.com" "disneyplus.com" "spotify.com" "globoplay.globo.com" "twitch.tv" "globo.com")
    local ecommerce_domains=("amazon.com.br" "www.amazon.com.br" "mercadolivre.com.br" "americanas.com.br" "magazineluiza.com.br" "shopee.com.br" "aliexpress.com" "olx.com.br" "ifood.com.br" "rappi.com.br")
    local productivity_domains=("google.com" "www.google.com" "google.com.br" "gmail.com" "drive.google.com" "microsoft.com" "outlook.com" "office.com" "zoom.us" "slack.com")
    local gaming_domains=("store.steampowered.com" "epicgames.com" "blizzard.com" "ea.com" "riotgames.com" "minecraft.net" "roblox.com" "xbox.com" "playstation.com" "nintendo.com")
    local governo_domains=("gov.br" "www.gov.br" "receita.fazenda.gov.br" "inss.gov.br" "tse.jus.br" "serasa.com.br" "spc.org.br" "fgts.caixa.gov.br")
    local news_domains=("uol.com.br" "folha.uol.com.br" "estadao.com.br" "oglobo.globo.com" "terra.com.br" "r7.com" "cnn.com" "bbc.com")
    local infrastructure_domains=("cloudflare.com" "amazonaws.com" "github.com" "www.github.com" "stackoverflow.com" "wikipedia.org" "pt.wikipedia.org" "archive.org")

    local total_ipv4_ok=0 total_ipv4_fail=0
    local total_ipv6_ok=0 total_ipv6_fail=0
    local total_domains_tested=0
    local result_summary=""

    test_category_domains() {
        local cat_name="$1"; shift
        local domains=("$@")
        local ipv4_ok=0 ipv4_fail=0 ipv6_ok=0 ipv6_fail=0

        echo ""
        echo "=== TESTANDO: $cat_name ==="

        for domain in "${domains[@]}"; do
            echo ""
            echo "Testando: $domain"

            if [[ $limpar_cache -eq 0 ]]; then
                unbound-control flush_zone "$domain" 2>/dev/null
            fi

            local out4 rc4
            out4=$(dig -4 @"$dns_server_v4" A "$domain" +noall +answer +time=3 +tries=1 2>&1)
            rc4=$?
            if [[ $rc4 -ne 0 || -z "$out4" || "$out4" == *"communications error"* || "$out4" == *"connection refused"* || "$out4" == *"network unreachable"* || "$out4" == *";;"* ]]; then
                echo "  IPv4: FALHA"
                ((ipv4_fail++))
            else
                echo "  IPv4: OK ($(echo "$out4" | wc -l) registro(s))"
                echo "$out4" | head -2
                ((ipv4_ok++))
            fi

            local out6 rc6
            out6=$(dig -6 @"$dns_server_v6" AAAA "$domain" +noall +answer +time=3 +tries=1 2>&1)
            rc6=$?
            if [[ $rc6 -ne 0 || -z "$out6" || "$out6" == *"communications error"* || "$out6" == *"connection refused"* || "$out6" == *"network unreachable"* || "$out6" == *";;"* ]]; then
                echo "  IPv6: FALHA"
                ((ipv6_fail++))
            else
                echo "  IPv6: OK ($(echo "$out6" | wc -l) registro(s))"
                echo "$out6" | head -2
                ((ipv6_ok++))
            fi

            ((total_domains_tested++))
            sleep 0.3
        done

        local total_cat=$(( ipv4_ok + ipv4_fail ))
        local ipv4_rate=$(( total_cat > 0 ? ipv4_ok * 100 / total_cat : 0 ))
        local ipv6_rate=$(( total_cat > 0 ? ipv6_ok * 100 / total_cat : 0 ))

        echo ""
        echo "Resultado $cat_name: IPv4 ${ipv4_ok}OK/${ipv4_fail}FAIL (${ipv4_rate}%) | IPv6 ${ipv6_ok}OK/${ipv6_fail}FAIL (${ipv6_rate}%)"

        ((total_ipv4_ok += ipv4_ok))
        ((total_ipv4_fail += ipv4_fail))
        ((total_ipv6_ok += ipv6_ok))
        ((total_ipv6_fail += ipv6_fail))

        result_summary+="$(printf '%-20s IPv4: %d%% | IPv6: %d%%\n' "$cat_name" "$ipv4_rate" "$ipv6_rate")"$'\n'
    }

    whiptail --title "Teste DNS" --msgbox "Iniciando testes. O resultado sera exibido no terminal.\nPressione Ok para comecar." 8 60

    local start_time
    start_time=$(date +%s)

    for category in "${selected_categories[@]}"; do
        case "$category" in
            bancos)         test_category_domains "BANCOS"         "${bancos_domains[@]}" ;;
            social)         test_category_domains "REDES SOCIAIS"  "${social_domains[@]}" ;;
            streaming)      test_category_domains "STREAMING"      "${streaming_domains[@]}" ;;
            ecommerce)      test_category_domains "E-COMMERCE"     "${ecommerce_domains[@]}" ;;
            productivity)   test_category_domains "PRODUTIVIDADE"  "${productivity_domains[@]}" ;;
            gaming)         test_category_domains "JOGOS"          "${gaming_domains[@]}" ;;
            governo)        test_category_domains "GOVERNO BR"     "${governo_domains[@]}" ;;
            news)           test_category_domains "NOTICIAS"       "${news_domains[@]}" ;;
            infrastructure) test_category_domains "INFRAESTRUTURA" "${infrastructure_domains[@]}" ;;
        esac
    done

    local end_time
    end_time=$(date +%s)
    local elapsed=$(( end_time - start_time ))

    local ipv4_rate_global=$(( total_domains_tested > 0 ? total_ipv4_ok * 100 / total_domains_tested : 0 ))
    local ipv6_rate_global=$(( total_domains_tested > 0 ? total_ipv6_ok * 100 / total_domains_tested : 0 ))

    local analise_v4 analise_v6
    if (( ipv4_rate_global > 90 )); then analise_v4="Excelente conectividade"
    elif (( ipv4_rate_global > 80 )); then analise_v4="Boa conectividade"
    elif (( ipv4_rate_global > 60 )); then analise_v4="Conectividade regular"
    else analise_v4="Problemas de conectividade"; fi

    if (( ipv6_rate_global > 70 )); then analise_v6="Excelente suporte IPv6"
    elif (( ipv6_rate_global > 50 )); then analise_v6="Bom suporte IPv6"
    elif (( ipv6_rate_global > 30 )); then analise_v6="Suporte IPv6 limitado"
    else analise_v6="Pouco suporte IPv6"; fi

    whiptail --title "Relatorio Final - Teste DNS" --msgbox \
"RESUMO POR CATEGORIA:
${result_summary}
TOTAIS:
  Dominios testados : $total_domains_tested
  IPv4 OK/FAIL      : ${total_ipv4_ok}/${total_ipv4_fail} (${ipv4_rate_global}%)
  IPv6 OK/FAIL      : ${total_ipv6_ok}/${total_ipv6_fail} (${ipv6_rate_global}%)
  Tempo de execucao : ${elapsed}s

ANALISE:
  IPv4 : $analise_v4
  IPv6 : $analise_v6" 28 65
}

fn_iptables_anycast() {
    apt install iptables iptables-persistent -y

    declare -a ssh_origins=()
    declare -a rules_v4=(
        "-A INPUT -i lo -j ACCEPT"
        "-A INPUT -m state --state RELATED,ESTABLISHED -j ACCEPT"
        "-A INPUT -p icmp -j ACCEPT"
        "-A OUTPUT -p icmp -j ACCEPT"
    )
    declare -a rules_v6=(
        "-A INPUT -i lo -j ACCEPT"
        "-A INPUT -m state --state RELATED,ESTABLISHED -j ACCEPT"
        "-A INPUT -p ipv6-icmp -j ACCEPT"
        "-A OUTPUT -p ipv6-icmp -j ACCEPT"
    )

    _coletar_origens ssh_origins "iptables - SSH" \
        "Origem permitida para SSH (CIDR ou IP)\nDeixe vazio para finalizar:"

    for src in "${ssh_origins[@]}"; do
        _ipt_add_port_rule rules_v4 rules_v6 tcp 22 "$src"
    done

    _ipt_liberar_dns rules_v4 rules_v6 0

    if systemctl is-active --quiet zabbix-agent2 2>/dev/null; then
        _ipt_liberar_zabbix rules_v4 rules_v6
    fi

    _ipt_loop_custom_ports rules_v4 rules_v6

    if systemctl cat frr &>/dev/null; then
        rules_v4+=("-A INPUT -p ospf -j ACCEPT" "-A OUTPUT -p ospf -j ACCEPT")
        rules_v6+=("-A INPUT -p ospf -j ACCEPT" "-A OUTPUT -p ospf -j ACCEPT")
    fi

    if ! _aplicar_ruleset rules_v4 rules_v6; then
        _hub_log ERROR "iptables_anycast: falha ao aplicar ruleset"
        return 1
    fi

    netfilter-persistent save
    _hub_log AUDIT "iptables_anycast: ruleset aplicado (${#rules_v4[@]} regras v4, ${#rules_v6[@]} regras v6)"
    whiptail --title "Concluido" --msgbox "Regras de iptables (IPv4 e IPv6) aplicadas atomicamente e salvas." 8 65
}

fn_configurar_loopbacks() {
    declare -a lo_ipv4s=()
    declare -a lo_ipv6s=()

    whiptail --title "Loopbacks - IPv4" --msgbox \
"Informe os IPs IPv4 a adicionar na loopback.
Ex: 192.0.2.1/32 (use seus IPs publicos reais)" 8 60

    while true; do
        lo_ip=$(whiptail --title "Loopbacks - IPv4" \
            --inputbox "IP IPv4 com mascara (ex: 192.0.2.1/32)\nDeixe vazio para finalizar:" 10 60 \
            3>&1 1>&2 2>&3)
        [[ $? -ne 0 || -z "$lo_ip" ]] && break
        lo_ipv4s+=("$lo_ip")
    done

    whiptail --title "Loopbacks - IPv6" --msgbox \
"Informe os IPs IPv6 a adicionar na loopback.
Ex: 2001:db8::1/128 (use seus IPs publicos reais)" 8 65

    while true; do
        lo_ip6=$(whiptail --title "Loopbacks - IPv6" \
            --inputbox "IP IPv6 com mascara (ex: 2001:db8::1/128)\nDeixe vazio para finalizar:" 10 60 \
            3>&1 1>&2 2>&3)
        [[ $? -ne 0 || -z "$lo_ip6" ]] && break
        lo_ipv6s+=("$lo_ip6")
    done

    if [[ ${#lo_ipv4s[@]} -eq 0 && ${#lo_ipv6s[@]} -eq 0 ]]; then
        whiptail --title "Loopbacks" --msgbox "Nenhum IP informado. Operacao cancelada." 8 50
        return 1
    fi

    local interfaces_file="/etc/network/interfaces"

    if ! grep -q "iface lo inet loopback" "$interfaces_file"; then
        whiptail --title "Erro" --msgbox "Bloco 'iface lo inet loopback' nao encontrado em $interfaces_file." 8 60
        return 1
    fi

    if grep -q "up ip addr add" "$interfaces_file"; then
        sed -i '/up ip addr add/d' "$interfaces_file"
        sed -i '/down ip addr del/d' "$interfaces_file"
    fi

    local tmp
    tmp=$(mktemp)
    while IFS= read -r line; do
        echo "$line" >> "$tmp"
        if [[ "$line" == *"iface lo inet loopback"* ]]; then
            for ip in "${lo_ipv4s[@]}"; do echo "    up ip addr add $ip dev lo" >> "$tmp"; done
            for ip in "${lo_ipv6s[@]}"; do echo "    up ip addr add $ip dev lo" >> "$tmp"; done
            for ip in "${lo_ipv4s[@]}"; do echo "    down ip addr del $ip dev lo" >> "$tmp"; done
            for ip in "${lo_ipv6s[@]}"; do echo "    down ip addr del $ip dev lo" >> "$tmp"; done
        fi
    done < "$interfaces_file"
    mv "$tmp" "$interfaces_file"

    local resumo=""
    for ip in "${lo_ipv4s[@]}"; do resumo+="  $ip\n"; done
    for ip in "${lo_ipv6s[@]}"; do resumo+="  $ip\n"; done

    whiptail --title "Loopbacks - Confirmacao" \
        --yesno "IPs a configurar:\n\n${resumo}\nAplicar agora com ifdown/ifup lo?" 16 60
    if [[ $? -eq 0 ]]; then
        ifdown lo && ifup lo
        whiptail --title "Concluido" --msgbox "Loopbacks configuradas e aplicadas com sucesso." 8 55
    else
        whiptail --title "Concluido" --msgbox "Loopbacks salvas em $interfaces_file.\nExecute 'ifdown lo && ifup lo' para aplicar." 10 60
    fi
}

fn_coletar_dados_anycast() {
    hostname_frr=$(whiptail --title "FRR - Hostname" \
        --inputbox "Hostname do roteador FRR\n(ex: DNS-ANYCAST-01):" 10 60 \
        3>&1 1>&2 2>&3)
    [[ $? -ne 0 || -z "$hostname_frr" ]] && return 1

    router_id=$(whiptail --title "FRR - Router ID" \
        --inputbox "Router ID do OSPF\n(ex: 203.0.113.1 - geralmente o IP publico principal):" 10 65 \
        3>&1 1>&2 2>&3)
    [[ $? -ne 0 || -z "$router_id" ]] && return 1

    mapfile -t ifaces_disp < <(ip link show | awk -F': ' '/^[0-9]+: / && !/lo/ {print $2}' | awk '{print $1}')
    local iface_opts=()
    for iface_item in "${ifaces_disp[@]}"; do iface_opts+=("$iface_item" ""); done

    iface_ospf=$(whiptail --title "FRR - Interface OSPF" \
        --menu "Selecione a interface de rede para o OSPF:" 20 60 8 \
        "${iface_opts[@]}" \
        3>&1 1>&2 2>&3)
    [[ $? -ne 0 || -z "$iface_ospf" ]] && return 1

    cpu_count=$(nproc)
    num_threads=$(whiptail --title "Unbound - Threads" \
        --inputbox "Numero de threads do Unbound\n(CPUs detectadas: ${cpu_count} | recomendado: ${cpu_count}):" 10 65 "$cpu_count" \
        3>&1 1>&2 2>&3)
    [[ $? -ne 0 || -z "$num_threads" ]] && num_threads="$cpu_count"

    mapfile -t unbound_interfaces < <(ip -4 addr show | awk '/inet / {print $2}' | cut -d/ -f1)
    mapfile -t ipv6_ifaces < <(ip -6 addr show | awk '/inet6 / {print $2}' | cut -d/ -f1 | grep -v '^fe80')

    local msg_ifaces="IPs detectados para o Unbound escutar:\n\nIPv4:\n"
    for ip in "${unbound_interfaces[@]}"; do msg_ifaces+="  $ip\n"; done
    msg_ifaces+="\nIPv6:\n"
    for ip in "${ipv6_ifaces[@]}"; do msg_ifaces+="  $ip\n"; done
    msg_ifaces+="\nDeseja prosseguir com esses enderecos?"

    whiptail --title "Unbound - Interfaces Detectadas" --yesno "$msg_ifaces" 22 60
    [[ $? -ne 0 ]] && return 1

    for ip in "${ipv6_ifaces[@]}"; do unbound_interfaces+=("$ip"); done

    outgoing_ipv4=""
    outgoing_ipv6=""

    mapfile -t all_ipv4s < <(ip -4 addr show | awk '/inet / {print $2}' | cut -d/ -f1 | grep -v '^127\.')
    if [[ ${#all_ipv4s[@]} -gt 0 ]]; then
        local pub_opts=()
        pub_opts+=("" "Nao definir outgoing IPv4")
        for pub_ip in "${all_ipv4s[@]}"; do pub_opts+=("$pub_ip" ""); done
        outgoing_ipv4=$(whiptail --title "Unbound - Outgoing IPv4" \
            --menu "Selecione o IP de saida para queries externas:\n(recomendado: IP publico da WAN)" 18 65 10 \
            "${pub_opts[@]}" \
            3>&1 1>&2 2>&3)
        [[ $? -ne 0 || "$outgoing_ipv4" == "" ]] && outgoing_ipv4=""
    fi

    outgoing_ipv6=$(whiptail --title "Unbound - Outgoing IPv6" \
        --inputbox "IP de saida IPv6 (outgoing-interface)\n(ex: 2001:db8::1 | deixe vazio para ignorar):" 10 65 \
        3>&1 1>&2 2>&3)
    [[ $? -ne 0 ]] && outgoing_ipv6=""

    fn_coletar_acl

    zabbix_server_ip=$(whiptail --title "Zabbix - Servidor" \
        --inputbox "IP do Zabbix Server ou Proxy\n(pode alterar depois em /etc/zabbix/zabbix_agent2.conf):" 10 65 \
        3>&1 1>&2 2>&3)
    [[ $? -ne 0 ]] && zabbix_server_ip="0.0.0.0/0"
}

