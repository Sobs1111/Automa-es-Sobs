// Converte as cores ANSI do backend para HTML. O escape de HTML acontece ANTES:
// a linha de log vem de um emissor externo e poderia carregar marcacao.
function colorize_log(string $line): string {
    $line = htmlspecialchars($line, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');

    $replacements = [
        '/\e\[0;31m/' => '<span style="color: #ff6b6b;">',
        '/\e\[0;32m/' => '<span style="color: #51cf66;">',
        '/\e\[0;34m/' => '<span style="color: #339af0;">',
        '/\e\[1;33m/' => '<span style="color: #fcc419;">',
        '/\e\[0;36m/' => '<span style="color: #66d9e8;">',
        '/\e\[0m/'    => '</span>',
    ];
    $line = preg_replace(array_keys($replacements), array_values($replacements), $line);

    return preg_replace('/\e\[[0-9;]*m/', '', $line);
}

