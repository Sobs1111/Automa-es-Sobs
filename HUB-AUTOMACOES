fn_zabbix_unbound() {
    fn_zabbix_comum

    cat > /etc/unbound/unbound.conf.d/statistics-enable.conf <<EOF
server:
    statistics-interval: 0
    statistics-cumulative: no
    extended-statistics: yes

remote-control:
    control-enable: yes
    control-interface: 127.0.0.1
    control-port: 8953
    server-key-file: "/etc/unbound/unbound_server.key"
    server-cert-file: "/etc/unbound/unbound_server.pem"
    control-key-file: "/etc/unbound/unbound_control.key"
    control-cert-file: "/etc/unbound/unbound_control.pem"
EOF

    unbound-control-setup

    apt install sudo -y

    local sudoers_tmp
    sudoers_tmp=$(mktemp)
    cat > "$sudoers_tmp" <<EOF
Defaults:zabbix !requiretty
zabbix ALL = NOPASSWD: /usr/sbin/unbound-control
EOF

    if visudo -cf "$sudoers_tmp" >/dev/null 2>&1; then
        install -m 0440 -o root -g root "$sudoers_tmp" /etc/sudoers.d/zabbix-agent
    else
        whiptail --title "Erro - sudoers" --msgbox "Falha na validacao do dropin sudoers. Regra NAO aplicada.\nArquivo temporario: $sudoers_tmp" 10 70
        rm -f "$sudoers_tmp"
        return 1
    fi
    rm -f "$sudoers_tmp"

    usermod -a -G unbound zabbix

    _escrever_userparameter_unbound
    systemctl restart unbound
    systemctl restart zabbix-agent2
    sys_hostname=$(hostname)
    whiptail --title "Concluido" --msgbox "Zabbix Agent2 com monitoramento do Unbound configurado.\nHostname: ${sys_hostname}" 8 60
}

