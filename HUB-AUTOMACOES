_huawei_cred_dir() {
    local dir="$HUB_CRED_DIR/huawei"
    mkdir -p "$dir" 2>/dev/null
    chmod 700 "$HUB_CRED_DIR" 2>/dev/null
    chmod 700 "$dir" 2>/dev/null
    printf '%s\n' "$dir"
}

_huawei_cred_load() {
    local file="$1" key val
    host=""; porta=""; user=""; senha=""
    while IFS='=' read -r key val; do
        case "$key" in
            HOST)  host="$val" ;;
            PORTA) porta="$val" ;;
            USER)  user="$val" ;;
            SENHA) senha="$val" ;;
        esac
    done < "$file"
    [[ -n "$host" && -n "$porta" && -n "$user" && -n "$senha" ]]
}

_huawei_cred_save() {
    local dir="$1" label="$2" host="$3" porta="$4" user="$5" senha="$6"
    local file="$dir/${label}.cred"
    {
        printf 'HOST=%s\n'  "$host"
        printf 'PORTA=%s\n' "$porta"
        printf 'USER=%s\n'  "$user"
        printf 'SENHA=%s\n' "$senha"
    } > "$file"
    chmod 600 "$file" 2>/dev/null
}

fn_huawei_bgp() {
    if ! command -v sshpass >/dev/null 2>&1; then
        echo "Instalando sshpass..."
        apt update -qq && apt install -y sshpass || {
            whiptail --title "Erro" --msgbox "Falha ao instalar sshpass." 8 50
            return 1
        }
    fi

    if ! command -v python3 >/dev/null 2>&1; then
        echo "Instalando python3..."
        apt update -qq && apt install -y python3 || {
            whiptail --title "Erro" --msgbox "Falha ao instalar python3." 8 50
            return 1
        }
    fi

    local cred_dir
    cred_dir=$(_huawei_cred_dir)

    local host="" porta="" user="" senha=""
    local usou_salva="no" label_atual=""

    local saved=()
    if [[ -d "$cred_dir" ]]; then
        while IFS= read -r -d '' f; do
            saved+=("$f")
        done < <(find "$cred_dir" -maxdepth 1 -type f -name '*.cred' -print0 2>/dev/null | sort -z)
    fi

    if (( ${#saved[@]} > 0 )); then
        local menu_opts=() i=1 lbl
        for f in "${saved[@]}"; do
            lbl=$(basename "$f" .cred)
            menu_opts+=("$i" "$lbl")
            ((i++))
        done
        menu_opts+=("N" "Digitar novas credenciais")

        local escolha
        escolha=$(whiptail --title "Huawei BGP - Credenciais Salvas" \
            --menu "Existem credenciais salvas em $cred_dir.\nSelecione qual usar:" \
            18 70 10 \
            "${menu_opts[@]}" \
            3>&1 1>&2 2>&3)
        [[ $? -ne 0 ]] && return 1

        if [[ "$escolha" != "N" ]]; then
            local idx=$((escolha - 1))
            local f="${saved[$idx]}"
            if _huawei_cred_load "$f"; then
                usou_salva="yes"
                label_atual=$(basename "$f" .cred)
            else
                whiptail --title "Erro" --msgbox "Arquivo de credencial invalido:\n$f" 10 60
                return 1
            fi
        fi
    fi

    if [[ "$usou_salva" != "yes" ]]; then
        host=$(whiptail --title "Huawei BGP - Host" \
            --inputbox "IP ou hostname do equipamento Huawei:" 8 60 \
            3>&1 1>&2 2>&3)
        [[ $? -ne 0 || -z "$host" ]] && return 1

        porta=$(whiptail --title "Huawei BGP - Porta" \
            --inputbox "Porta SSH:" 8 60 "22" \
            3>&1 1>&2 2>&3)
        [[ $? -ne 0 || -z "$porta" ]] && return 1

        user=$(whiptail --title "Huawei BGP - Usuario" \
            --inputbox "Usuario SSH:" 8 60 "admin" \
            3>&1 1>&2 2>&3)
        [[ $? -ne 0 || -z "$user" ]] && return 1

        senha=$(whiptail --title "Huawei BGP - Senha" \
            --passwordbox "Senha SSH para $user@$host:" 8 60 \
            3>&1 1>&2 2>&3)
        [[ $? -ne 0 || -z "$senha" ]] && return 1

        if whiptail --title "Salvar credencial?" \
            --yesno "Deseja salvar estas credenciais para uso futuro?\n\nLocal: $cred_dir\nPermissoes: 0600 (somente root)" \
            12 70; then
            local label=""
            while true; do
                label=$(whiptail --title "Salvar credencial - Rotulo" \
                    --inputbox "Nome (rotulo) para identificar esta credencial.\nUse apenas letras, numeros, '_' ou '-'." \
                    10 70 "$host" \
                    3>&1 1>&2 2>&3)
                [[ $? -ne 0 ]] && break
                if [[ -z "$label" || ! "$label" =~ ^[A-Za-z0-9_-]+$ ]]; then
                    whiptail --title "Rotulo invalido" --msgbox \
                        "Use apenas letras, numeros, '_' e '-'." 8 50
                    continue
                fi
                if [[ -e "$cred_dir/${label}.cred" ]]; then
                    if ! whiptail --title "Sobrescrever?" \
                        --yesno "Ja existe credencial com rotulo '$label'.\nSobrescrever?" 10 60; then
                        continue
                    fi
                fi
                _huawei_cred_save "$cred_dir" "$label" "$host" "$porta" "$user" "$senha"
                label_atual="$label"
                break
            done
        fi
    fi

    clear
    echo "======================================================"
    echo "Consultando BGP em $user@$host:$porta"
    [[ -n "$label_atual" ]] && echo "Credencial: $label_atual"
    echo "Comandos: display ip interface brief / display ipv6 interface brief / display bgp all summary"
    echo "======================================================"
    echo ""

    local tmp_out
    tmp_out=$(mktemp /tmp/hub_bgp.XXXXXX 2>/dev/null) || tmp_out="/tmp/hub_bgp_$$.out"

    SSHPASS="$senha" sshpass -e ssh \
        -o StrictHostKeyChecking=no \
        -o UserKnownHostsFile=/dev/null \
        -o LogLevel=ERROR \
        -o ConnectTimeout=15 \
        -o KexAlgorithms=+diffie-hellman-group1-sha1,diffie-hellman-group14-sha1,diffie-hellman-group-exchange-sha1 \
        -o HostKeyAlgorithms=+ssh-rsa \
        -o PubkeyAcceptedAlgorithms=+ssh-rsa \
        -o PubkeyAuthentication=no \
        -o Ciphers=+aes128-cbc \
        -p "$porta" "$user@$host" >"$tmp_out" 2>&1 <<'EOF'
screen-length 0 temporary
display ip interface brief
display ipv6 interface brief
display bgp all summary
quit
EOF
    local rc=$?

    local parsed
    parsed=$(python3 - "$tmp_out" <<'PYEOF'
import sys, re, ipaddress

try:
    with open(sys.argv[1], errors='replace') as f:
        text = f.read()
except Exception:
    sys.exit(0)

def extract_block(text, cmd):
    pat = re.compile(r'(?:^|\n)[^\n]*>' + re.escape(cmd) + r'\s*\n')
    m = pat.search(text)
    if not m:
        return ''
    rest = text[m.end():]
    em = re.search(r'\n<[^>]+>', rest)
    return rest[:em.start()] if em else rest

ifb4 = extract_block(text, 'display ip interface brief')
ifb6 = extract_block(text, 'display ipv6 interface brief')
bgp  = extract_block(text, 'display bgp all summary')

def norm_phy(ph):
    if not ph:
        return '-'
    p = ph.lower().lstrip('*^!')
    if p == 'up':
        return 'UP'
    if p.startswith('down'):
        return 'DOWN'
    return ph.upper()

interfaces_v4 = []
for line in ifb4.splitlines():
    if not line.strip():
        continue
    parts = line.split()
    if len(parts) < 4:
        continue
    if parts[0] in ('Interface', 'The'):
        continue
    if parts[0].startswith(('*', '^', '(')):
        continue
    name, ipmask = parts[0], parts[1]
    if ipmask.lower() == 'unassigned':
        continue
    physical = parts[2] if len(parts) >= 3 else ''
    vpn = parts[4] if len(parts) >= 5 else ''
    try:
        net = ipaddress.ip_network(ipmask, strict=False)
        if net.version != 4:
            continue
    except ValueError:
        continue
    interfaces_v4.append((name, net, vpn, physical))

interfaces_v6 = []
current_iface = None
current_phy = ''
for line in ifb6.splitlines():
    stripped = line.strip()
    if not stripped:
        continue
    if stripped.startswith(('*', '^', '!', '(')):
        continue
    if stripped.startswith('Interface') and 'Physical' in stripped:
        continue
    if stripped.startswith('The number of'):
        continue
    m = re.match(r'\[IPv6 Address[^\]]*\]\s+(\S+)', stripped)
    if m and current_iface:
        try:
            net = ipaddress.ip_network(m.group(1), strict=False)
            if net.version == 6:
                interfaces_v6.append((current_iface, net, current_phy))
        except ValueError:
            pass
        continue
    parts = stripped.split()
    if parts and re.match(r'^[A-Za-z0-9][\w/.\-:]*$', parts[0]):
        current_iface = parts[0]
        current_phy = parts[1] if len(parts) >= 2 else ''

peers = []
family = None
vpn = None
for line in bgp.splitlines():
    if 'Peer of IPv4-family for vpn instance' in line:
        family = 'IPv4'; continue
    if 'Peer of IPv6-family for vpn instance' in line:
        family = 'IPv6'; continue
    if 'Peer of IPv4-family for public' in line:
        family = 'IPv4'; vpn = '_public_'; continue
    if 'Peer of IPv6-family for public' in line:
        family = 'IPv6'; vpn = '_public_'; continue
    m = re.match(r'\s*VPN-Instance\s+(\S+?),', line)
    if m:
        vpn = m.group(1); continue
    if 'Address Family' in line:
        family = None; vpn = None; continue
    if family is None:
        continue
    stripped = line.strip()
    if not stripped:
        continue
    if stripped.startswith('Peer') and 'AS' in stripped:
        continue
    if stripped.startswith('-') or stripped.startswith('Total number of peers'):
        continue
    parts = stripped.split()
    if not parts or len(parts) < 9:
        continue
    try:
        if family == 'IPv4':
            ipaddress.IPv4Address(parts[0])
        else:
            ipaddress.IPv6Address(parts[0])
    except ValueError:
        continue
    state = parts[6] if len(parts) == 9 else ' '.join(parts[6:-2])
    peers.append((family, vpn, parts[0], state))

def find_iface(family, vpn, peer):
    try:
        ip = ipaddress.ip_address(peer)
    except ValueError:
        return ('-', '-')
    if family == 'IPv4':
        same = [(n, ph) for n, net, v, ph in interfaces_v4 if ip in net and vpn and v == vpn]
        if same:
            return (same[0][0], norm_phy(same[0][1]))
        anym = [(n, ph) for n, net, v, ph in interfaces_v4 if ip in net]
        if anym:
            return (anym[0][0], norm_phy(anym[0][1]))
        return ('-', '-')
    matches = [(n, ph) for n, net, ph in interfaces_v6 if ip in net]
    if matches:
        return (matches[0][0], norm_phy(matches[0][1]))
    return ('-', '-')

for family, vpn, peer, state in peers:
    iface, status = find_iface(family, vpn, peer)
    print(f'{family}|{peer}|{state}|{iface}|{status}')
PYEOF
)

    echo "--------------------------------------------------------------------------------------------------------"
    if [[ -n "$parsed" ]]; then
        printf '%-6s %-40s %-14s %-26s %s\n' "TIPO" "PEER" "ESTADO" "INTERFACE" "STATUS"
        printf -- '------ ---------------------------------------- -------------- -------------------------- ------\n'
        while IFS='|' read -r tipo peer estado iface status; do
            printf '%-6s %-40s %-14s %-26s %s\n' "$tipo" "$peer" "$estado" "$iface" "$status"
        done <<< "$parsed"

        local total total_v4 total_v6 total_est total_no_iface total_down
        total=$(printf '%s\n' "$parsed" | wc -l)
        total_v4=$(printf '%s\n' "$parsed" | grep -c '^IPv4|')
        total_v6=$(printf '%s\n' "$parsed" | grep -c '^IPv6|')
        total_est=$(printf '%s\n' "$parsed" | grep -c '|Established|')
        total_no_iface=$(printf '%s\n' "$parsed" | grep -c '|-|-$')
        total_down=$(printf '%s\n' "$parsed" | grep -c '|DOWN$')
        echo "--------------------------------------------------------------------------------------------------------"
        echo "Resumo: $total peers ($total_v4 IPv4 / $total_v6 IPv6) | $total_est em Established"
        if (( total_down > 0 )); then
            echo "Obs: $total_down peer(s) com interface DOWN."
        fi
        if (( total_no_iface > 0 )); then
            echo "Obs: $total_no_iface peer(s) sem interface direta (possivel iBGP via loopback)."
        fi
    else
        echo "Nao foi possivel extrair peers. Saida bruta:"
        echo ""
        cat "$tmp_out"
    fi

    rm -f "$tmp_out"

    echo ""
    echo "======================================================"
    if [[ -n "$parsed" ]]; then
        echo "Consulta concluida."
    elif [[ $rc -eq 0 ]]; then
        echo "Consulta finalizada com sucesso, mas sem peers identificados."
    else
        echo "Consulta falhou (rc=$rc). Verifique credenciais/conectividade."
    fi
    echo "======================================================"
    read -rp "Pressione Enter para voltar ao menu..."
}

# =============================================================================
# Syslog CGNAT - kit de coleta e consulta
#
# Coleta: rsyslog recebe em UDP/514 num ruleset dedicado e grava um arquivo por
# host emissor. O ruleset proprio evita que o log dos CGNATs caia no ruleset
# padrao (e portanto no /var/log/syslog), sem depender da ordem de inclusao dos
# arquivos em /etc/rsyslog.d.
#
# Consulta: dois caminhos complementares.
#   - cgnat-hunter-daily: pericia sobre o arquivo (IP publico + porta -> IP
#     privado). E a fonte de verdade, com a retencao legal completa.
#   - LogAnalyzer sobre MariaDB: janela recente navegavel, com expurgo proprio
#     para a tabela nao crescer sem limite.
# =============================================================================

readonly SYSLOG_LA_VERSION="5.0.1"
readonly SYSLOG_LA_URL="https://github.com/rsyslog/loganalyzer/releases/download/v5.0.1/loganalyzer-5.0.1.tar.gz"
readonly SYSLOG_HUNTER_BIN="/usr/local/bin/cgnat-hunter-daily"
readonly SYSLOG_WEB_DIR="/var/www/html/cgnat_hunter"
readonly SYSLOG_HTPASSWD="/etc/apache2/cgnat_hunter.htpasswd"
readonly SYSLOG_AUDIT_LOG="/var/log/cgnat-hunter-audit.log"

_syslog_coletar_dados() {
    declare -g syslog_log_dir="/var/log/cgnat"
    declare -g syslog_retencao="1830"
    declare -g syslog_porta="514"
    declare -g syslog_usar_db="no"
    declare -g syslog_db_retencao="90"
    declare -g syslog_db_pwd=""
    declare -g syslog_web_user="cgnat"
    declare -g syslog_web_pwd=""
    declare -g -a syslog_origens=()

    syslog_log_dir=$(whiptail --title "Syslog CGNAT - Armazenamento" \
        --inputbox "Diretorio base dos logs:" 10 60 "/var/log/cgnat" \
        3>&1 1>&2 2>&3) || return 1
    [[ -z "$syslog_log_dir" ]] && syslog_log_dir="/var/log/cgnat"

    syslog_retencao=$(whiptail --title "Syslog CGNAT - Retencao" \
        --inputbox "Retencao dos arquivos, em dias:\n(1830 = 5 anos)" 11 60 "1830" \
        3>&1 1>&2 2>&3) || return 1
    if ! [[ "$syslog_retencao" =~ ^[0-9]+$ ]] || (( syslog_retencao < 1 )); then
        whiptail --title "Erro" --msgbox "Retencao invalida: $syslog_retencao" 8 60
        return 1
    fi

    syslog_porta=$(whiptail --title "Syslog CGNAT - Recepcao" \
        --inputbox "Porta UDP de recepcao:" 10 60 "514" \
        3>&1 1>&2 2>&3) || return 1
    if ! [[ "$syslog_porta" =~ ^[0-9]+$ ]] || (( syslog_porta < 1 || syslog_porta > 65535 )); then
        whiptail --title "Erro" --msgbox "Porta invalida: $syslog_porta" 8 60
        return 1
    fi

    whiptail --title "Syslog CGNAT - Origens" --msgbox \
"Informe os IPs ou blocos CIDR das caixas CGNAT autorizadas a enviar log.

Somente essas origens serao liberadas no firewall.
Deixe vazio para finalizar." 12 65

    _coletar_origens syslog_origens "Syslog CGNAT - Origens" \
        "IP ou CIDR da caixa CGNAT\n(deixe vazio para finalizar):"

    if [[ ${#syslog_origens[@]} -eq 0 ]]; then
        whiptail --title "Syslog CGNAT" --yesno \
"Nenhuma origem informada.\n\nA porta ${syslog_porta}/udp ficaria aberta para qualquer host, o que permite injecao de log forjado.\n\nProsseguir mesmo assim?" 13 68 || return 1
    fi

    if whiptail --title "Syslog CGNAT - Banco" --yesno \
"Instalar tambem MariaDB + LogAnalyzer ${SYSLOG_LA_VERSION}?

Da uma interface web para navegar o log recente. O arquivo continua
sendo a fonte de verdade com a retencao completa; o banco guarda
apenas uma janela curta, com expurgo automatico.

Responda Nao para instalar so o coletor e o CGNAT Hunter." 16 70; then
        syslog_usar_db="yes"

        syslog_db_retencao=$(whiptail --title "Syslog CGNAT - Retencao do banco" \
            --inputbox "Retencao na tabela SystemEvents, em dias:\n(janela de navegacao do LogAnalyzer)" 11 60 "90" \
            3>&1 1>&2 2>&3) || return 1
        if ! [[ "$syslog_db_retencao" =~ ^[0-9]+$ ]] || (( syslog_db_retencao < 1 )); then
            whiptail --title "Erro" --msgbox "Retencao invalida: $syslog_db_retencao" 8 60
            return 1
        fi
    else
        syslog_usar_db="no"
    fi

    syslog_web_user=$(whiptail --title "Syslog CGNAT - Acesso web" \
        --inputbox "Usuario para acessar o CGNAT Hunter:" 10 60 "cgnat" \
        3>&1 1>&2 2>&3) || return 1
    if ! [[ "$syslog_web_user" =~ ^[a-zA-Z0-9_.-]+$ ]]; then
        whiptail --title "Erro" --msgbox "Usuario invalido: $syslog_web_user" 8 60
        return 1
    fi

    syslog_web_pwd=$(whiptail --title "Syslog CGNAT - Acesso web" \
        --passwordbox "Senha para o usuario ${syslog_web_user}:" 10 60 \
        3>&1 1>&2 2>&3) || return 1
    if [[ ${#syslog_web_pwd} -lt 8 ]]; then
        whiptail --title "Erro" --msgbox "A senha precisa ter ao menos 8 caracteres." 8 60
        return 1
    fi

    # A senha do banco nao e digitada: e gerada e guardada em HUB_CRED_DIR, para
    # nao repetir a senha do root do MariaDB no arquivo de configuracao do rsyslog.
    syslog_db_pwd=$(tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 24)

    return 0
}

_syslog_instalar_pacotes() {
    # O hunter usa match() com terceiro argumento, que so existe no gawk. O awk
    # padrao do Debian e o mawk, entao o gawk entra como dependencia explicita.
    local -a pkgs=(rsyslog gawk gzip chrony apache2 apache2-utils php libapache2-mod-php)

    apt update -qq

    if [[ "$syslog_usar_db" == "yes" ]]; then
        # O mariadb-server precisa estar instalado E NO AR antes do
        # rsyslog-mysql: numa instalacao unica o dpkg configura o rsyslog-mysql
        # primeiro, o postinst dele nao acha o socket e o dbconfig-common falha.
        echo "Instalando MariaDB..."
        if ! apt install -y -o Dpkg::Options::="--force-confold" mariadb-server; then
            whiptail --title "Erro" --msgbox "Falha ao instalar o MariaDB." 8 60
            return 1
        fi

        systemctl enable --now mariadb
        local i
        for i in $(seq 1 30); do
            mariadb -e "SELECT 1" >/dev/null 2>&1 && break
            sleep 1
        done
        if ! mariadb -e "SELECT 1" >/dev/null 2>&1; then
            whiptail --title "Erro - MariaDB" --msgbox "MariaDB nao subiu; abortando." 8 60
            return 1
        fi

        # Impede o dbconfig-common de criar banco, usuario e o proprio
        # /etc/rsyslog.d/mysql.conf: quem cuida disso e o kit, com a senha que
        # ele gerou. Sem isso ficam duas configuracoes de ommysql concorrendo.
        echo "rsyslog-mysql rsyslog-mysql/dbconfig-install boolean false" | debconf-set-selections
        echo "rsyslog-mysql rsyslog-mysql/dbconfig-upgrade boolean false" | debconf-set-selections

        pkgs+=(rsyslog-mysql php-mysql php-gd)
    fi

    echo "Instalando pacotes: ${pkgs[*]}"
    if ! apt install -y -o Dpkg::Options::="--force-confold" "${pkgs[@]}"; then
        whiptail --title "Erro" --msgbox "Falha ao instalar os pacotes do kit syslog." 8 60
        return 1
    fi
    return 0
}

_syslog_config_rsyslog() {
    local conf="/etc/rsyslog.d/10-cgnat.conf"

    mkdir -p "$syslog_log_dir"
    chown root:adm "$syslog_log_dir"
    chmod 0750 "$syslog_log_dir"

    # O pacote rsyslog-mysql instala um mysql.conf proprio que carrega o ommysql
    # e manda *.* para o banco. Com o dbconfig desativado ele fica sem
    # credencial valida, e de todo modo duplicaria o que este arquivo ja faz.
    if [[ -f /etc/rsyslog.d/mysql.conf ]]; then
        mv /etc/rsyslog.d/mysql.conf /etc/rsyslog.d/mysql.conf.disabled
    fi

    # O ommysql nao e carregado por padrao: sem este module() o rsyslog recusa a
    # action com "module name 'ommysql' is unknown".
    local mod_mysql=""
    [[ "$syslog_usar_db" == "yes" ]] && mod_mysql='module(load="ommysql")'

    # A config do rsyslog nao tem nenhum "$", entao o heredoc pode ser expandido
    # com seguranca - o %HOSTNAME% dele nao e variavel de shell.
    cat > "$conf" <<EOF
# Gerado por HUB-AUTOMACOES - coleta de log CGNAT
#
# O %HOSTNAME% passa por secpath-replace: sem isso um emissor forjado poderia
# mandar um hostname com barras e escrever fora do diretorio de log.
#
# O ruleset proprio isola esse trafego do ruleset padrao, entao o log dos
# CGNATs nao entra no /var/log/syslog e nao depende de "stop" em outro arquivo.

module(load="imudp" threads="2" timeRequery="8")
${mod_mysql}

template(name="CgnatFile" type="string"
         string="${syslog_log_dir}/%HOSTNAME:::secpath-replace%.log")

ruleset(name="cgnat"
        queue.type="LinkedList"
        queue.size="200000"
        queue.dequeueBatchSize="1000") {

    action(type="omfile"
           dynaFile="CgnatFile"
           dynaFileCacheSize="100"
           template="RSYSLOG_FileFormat"
           dirCreateMode="0750"
           fileCreateMode="0640"
           fileOwner="root"
           fileGroup="adm"
           ioBufferSize="64k"
           flushOnTXEnd="off"
           asyncWriting="on")
EOF

    if [[ "$syslog_usar_db" == "yes" ]]; then
        cat >> "$conf" <<EOF

    # Fila em disco: se o MariaDB cair, a mensagem espera em vez de se perder.
    action(type="ommysql"
           server="localhost"
           db="Syslog"
           uid="rsyslog"
           pwd="${syslog_db_pwd}"
           queue.type="LinkedList"
           queue.filename="q_cgnat_mysql"
           queue.maxDiskSpace="2g"
           queue.saveOnShutdown="on"
           action.resumeRetryCount="-1")
EOF
    fi

    cat >> "$conf" <<EOF
}

# rcvbufSize maior e rate limit desligado: no volume de CGNAT o padrao descarta
# mensagem em silencio, o que e inaceitavel para log com valor probatorio.
input(type="imudp"
      port="${syslog_porta}"
      rcvbufSize="16m"
      ratelimit.interval="0"
      ruleset="cgnat")
EOF

    chmod 0600 "$conf"
    chown root:root "$conf"

    if ! rsyslogd -N1 >/dev/null 2>&1; then
        whiptail --title "Erro - rsyslog" --msgbox \
"A configuracao gerada nao passou no teste de sintaxe.

Rode 'rsyslogd -N1' para ver o detalhe.
Arquivo: $conf" 12 65
        return 1
    fi

    systemctl enable --now rsyslog
    systemctl restart rsyslog
    return 0
}

_syslog_config_logrotate() {
    local conf="/etc/logrotate.d/cgnat"

    # compress + delaycompress: o arquivo do dia anterior fica em texto puro (a
    # busca mais comum) e o resto do acervo comprime. O hunter usa zgrep, entao
    # le os dois casos.
    cat > "$conf" <<EOF
${syslog_log_dir}/*.log {
    daily
    rotate ${syslog_retencao}
    dateext
    dateformat -%Y%m%d
    missingok
    notifempty
    compress
    delaycompress
    create 0640 root adm
    sharedscripts
    postrotate
        systemctl kill -s HUP rsyslog.service >/dev/null 2>&1 || true
    endscript
}
EOF

    chmod 0644 "$conf"

    if ! logrotate -d "$conf" >/dev/null 2>&1; then
        whiptail --title "Erro - logrotate" --msgbox \
"A configuracao de rotacao nao passou no teste.
Rode 'logrotate -d $conf' para ver o detalhe." 10 65
        return 1
    fi

    systemctl enable --now logrotate.timer 2>/dev/null || true
    return 0
}

_syslog_config_mariadb() {
    [[ "$syslog_usar_db" != "yes" ]] && return 0

    systemctl enable --now mariadb
    systemctl restart mariadb

    # Aguarda o socket subir antes de mandar SQL.
    local i
    for i in $(seq 1 30); do
        mariadb -e "SELECT 1" >/dev/null 2>&1 && break
        sleep 1
    done

    if ! mariadb -e "SELECT 1" >/dev/null 2>&1; then
        whiptail --title "Erro - MariaDB" --msgbox "Nao foi possivel conectar ao MariaDB local." 8 60
        return 1
    fi

    # O schema do pacote rsyslog-mysql nao traz processid nem checksum, que o
    # LogAnalyzer espera; sem elas a home dele quebra com "Unknown column".
    # E a SystemEvents nasce so com PRIMARY KEY(ID), o que faz cada consulta do
    # LogAnalyzer varrer a tabela inteira.
    mariadb <<SQLEOF
CREATE DATABASE IF NOT EXISTS Syslog CHARACTER SET utf8mb4;
CREATE USER IF NOT EXISTS 'rsyslog'@'localhost' IDENTIFIED BY '${syslog_db_pwd}';
ALTER USER 'rsyslog'@'localhost' IDENTIFIED BY '${syslog_db_pwd}';
GRANT ALL PRIVILEGES ON Syslog.* TO 'rsyslog'@'localhost';
FLUSH PRIVILEGES;
SQLEOF

    if [[ -f /usr/share/dbconfig-common/data/rsyslog-mysql/install/mysql ]]; then
        mariadb Syslog < /usr/share/dbconfig-common/data/rsyslog-mysql/install/mysql 2>/dev/null || true
    fi

    mariadb Syslog <<SQLEOF
ALTER TABLE SystemEvents ADD COLUMN IF NOT EXISTS checksum INT NOT NULL DEFAULT 0;
ALTER TABLE SystemEvents ADD COLUMN IF NOT EXISTS processid VARCHAR(60) NOT NULL DEFAULT '';
CREATE INDEX IF NOT EXISTS idx_devicereportedtime ON SystemEvents (DeviceReportedTime);
CREATE INDEX IF NOT EXISTS idx_receivedat ON SystemEvents (ReceivedAt);
CREATE INDEX IF NOT EXISTS idx_fromhost ON SystemEvents (FromHost);
SQLEOF

    # Expurgo em lotes pequenos, de hora em hora: um DELETE unico sobre milhoes
    # de linhas travaria a tabela e a ingestao junto.
    mariadb <<SQLEOF
SET GLOBAL event_scheduler = ON;
DROP EVENT IF EXISTS Syslog.purge_systemevents;
CREATE EVENT Syslog.purge_systemevents
ON SCHEDULE EVERY 1 HOUR
DO DELETE FROM Syslog.SystemEvents
   WHERE ReceivedAt < NOW() - INTERVAL ${syslog_db_retencao} DAY
   LIMIT 50000;
SQLEOF

    mkdir -p /etc/mysql/mariadb.conf.d
    cat > /etc/mysql/mariadb.conf.d/99-cgnat.cnf <<'EOF'
[mysqld]
event_scheduler = ON
EOF

    systemctl restart mariadb

    local cred_dir="$HUB_CRED_DIR/syslog"
    mkdir -p "$cred_dir"
    chmod 700 "$HUB_CRED_DIR" 2>/dev/null
    chmod 700 "$cred_dir" 2>/dev/null
    {
        printf 'DB=Syslog\n'
        printf 'USER=rsyslog\n'
        printf 'SENHA=%s\n' "$syslog_db_pwd"
    } > "$cred_dir/mariadb.cred"
    chmod 600 "$cred_dir/mariadb.cred"

    return 0
}

_syslog_instalar_loganalyzer() {
    [[ "$syslog_usar_db" != "yes" ]] && return 0

    local tmp="/tmp/loganalyzer-${SYSLOG_LA_VERSION}.tar.gz"
    local dest="/var/www/html/logs"

    echo "Baixando LogAnalyzer ${SYSLOG_LA_VERSION}..."
    if ! wget -q "$SYSLOG_LA_URL" -O "$tmp" || [[ ! -s "$tmp" ]]; then
        whiptail --title "Erro" --msgbox \
"Falha ao baixar o LogAnalyzer ${SYSLOG_LA_VERSION}.
Verifique a conectividade. O restante do kit segue instalado." 10 65
        return 1
    fi

    rm -rf "/tmp/loganalyzer-${SYSLOG_LA_VERSION}"
    tar -xzf "$tmp" -C /tmp || return 1

    rm -rf "$dest"
    mv "/tmp/loganalyzer-${SYSLOG_LA_VERSION}/src" "$dest" || return 1

    # O configure.sh do projeto so cria um config.php gravavel no diretorio
    # corrente; roda-lo de outro lugar deixa o instalador sem onde escrever.
    touch "$dest/config.php"
    chown -R www-data:www-data "$dest"
    chmod 0660 "$dest/config.php"

    rm -rf "/tmp/loganalyzer-${SYSLOG_LA_VERSION}" "$tmp"

    systemctl restart apache2
    return 0
}

_syslog_instalar_hunter() {
    cat > "$SYSLOG_HUNTER_BIN" <<'HUNTEREOF'
#!/bin/bash
# =============================================================================
# cgnat-hunter-daily
#
# Localiza a alocacao CGNAT (IP publico + porta -> IP privado) sobre logs com
# rotacao DIARIA. Gerado por HUB-AUTOMACOES.
#
# Uso:  cgnat-hunter-daily <data_inicio> <data_fim> <ip_publico> [porta] [host]
#       cgnat-hunter-daily            (sem argumentos = modo interativo)
# =============================================================================

set -uo pipefail

BASE_LOG_DIR="${CGNAT_LOG_DIR:-@@LOG_DIR@@}"

GREEN='\033[0;32m'; RED='\033[0;31m'; BLUE='\033[0;34m'
YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'

INTERACTIVE=0
[[ $# -eq 0 ]] && INTERACTIVE=1

# -----------------------------------------------------------------------------
# Validacao de entrada
# -----------------------------------------------------------------------------
_valida_data() {
    [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || return 1
    date -d "$1" >/dev/null 2>&1
}

_valida_ip() {
    [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || return 1
    local a b c d o
    IFS=. read -r a b c d <<< "$1"
    for o in "$a" "$b" "$c" "$d"; do
        (( 10#$o <= 255 )) || return 1
    done
    return 0
}

_valida_porta() {
    [[ -z "$1" ]] && return 0
    [[ "$1" =~ ^[0-9]+$ ]] || return 1
    (( 10#$1 >= 1 && 10#$1 <= 65535 ))
}

# -----------------------------------------------------------------------------
# 1. Entrada
# -----------------------------------------------------------------------------
if [[ $# -ge 3 ]]; then
    START_DATE="$1"
    END_DATE="$2"
    TARGET_IP="$3"
    TARGET_PORT="${4:-}"
    TARGET_HOST="${5:-}"
    [[ -z "$END_DATE" ]] && END_DATE="$START_DATE"
elif [[ $INTERACTIVE -eq 1 ]]; then
    echo ""
    echo -e "${BLUE}================================================================${NC}"
    echo -e "${CYAN}   CGNAT HUNTER - DIARIO   ${NC}"
    echo -e "${BLUE}================================================================${NC}"

    echo -ne "Data INICIAL (YYYY-MM-DD) [Hoje]: "
    read -r START_DATE
    START_DATE=${START_DATE:-$(date +%Y-%m-%d)}

    echo -ne "Data FINAL   (YYYY-MM-DD) [Igual Inicio]: "
    read -r END_DATE
    END_DATE=${END_DATE:-$START_DATE}

    TARGET_IP=""
    while [[ -z "$TARGET_IP" ]]; do
        echo -ne "IP Publico Alvo (Ex: 143.137.10.20): "
        read -r TARGET_IP
        [[ -z "$TARGET_IP" ]] && echo -e "${RED}Erro: o IP e obrigatorio.${NC}"
    done

    echo -ne "Porta Alvo (Enter para ver TUDO): "
    read -r TARGET_PORT

    echo -ne "Caixa CGNAT (Enter para TODAS): "
    read -r TARGET_HOST
else
    echo -e "${RED}Uso: $(basename "$0") <data_inicio> <data_fim> <ip> [porta] [host]${NC}" >&2
    exit 2
fi

_valida_data "$START_DATE" || { echo -e "${RED}Data inicial invalida: ${START_DATE}${NC}" >&2; exit 1; }
_valida_data "$END_DATE"   || { echo -e "${RED}Data final invalida: ${END_DATE}${NC}" >&2; exit 1; }
_valida_ip   "$TARGET_IP"  || { echo -e "${RED}IP publico invalido: ${TARGET_IP}${NC}" >&2; exit 1; }
_valida_porta "$TARGET_PORT" || { echo -e "${RED}Porta invalida: ${TARGET_PORT}${NC}" >&2; exit 1; }

if [[ $(date -d "$START_DATE" +%Y%m%d) -gt $(date -d "$END_DATE" +%Y%m%d) ]]; then
    echo -e "${RED}Erro: a data inicial e posterior a data final.${NC}" >&2
    exit 1
fi

if [[ -n "$TARGET_HOST" ]] && ! [[ "$TARGET_HOST" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo -e "${RED}Nome de host invalido: ${TARGET_HOST}${NC}" >&2
    exit 1
fi

# -----------------------------------------------------------------------------
# 2. Dependencia: gawk
#    match() com terceiro argumento e extensao do gawk; o mawk (padrao do
#    Debian) nao suporta e falharia silenciosamente na captura dos grupos.
# -----------------------------------------------------------------------------
AWK_BIN=""
for _cand in gawk awk; do
    if command -v "$_cand" >/dev/null 2>&1 &&
       echo "x" | "$_cand" '{ if (match($0, /(x)/, a)) exit 0; exit 1 }' >/dev/null 2>&1; then
        AWK_BIN="$_cand"
        break
    fi
done
if [[ -z "$AWK_BIN" ]]; then
    echo -e "${RED}Erro: gawk nao encontrado. Instale com: apt install gawk${NC}" >&2
    exit 1
fi

# -----------------------------------------------------------------------------
# 3. Descoberta de hosts
#    Um arquivo por caixa CGNAT. Sem filtro explicito, varre todas - uma caixa
#    nova nao pode ficar invisivel para a busca.
# -----------------------------------------------------------------------------
declare -a HOSTS=()
if [[ -n "$TARGET_HOST" ]]; then
    HOSTS=("$TARGET_HOST")
else
    mapfile -t HOSTS < <(
        find "$BASE_LOG_DIR" -maxdepth 1 -type f -name '*.log*' -printf '%f\n' 2>/dev/null |
            sed -E 's/\.log(-[0-9]{8})?(\.gz)?$//' |
            sort -u
    )
fi

if [[ ${#HOSTS[@]} -eq 0 ]]; then
    echo -e "${RED}Nenhum arquivo de log encontrado em ${BASE_LOG_DIR}.${NC}" >&2
    exit 1
fi

# -----------------------------------------------------------------------------
# 4. Selecao de arquivos
#
#    Com dateext, o logrotate nomeia o arquivo com a data DA ROTACAO. Como o
#    logrotate.timer roda entre 00:00 e 01:00, HOST.log-YYYYMMDD contem o dia
#    anterior inteiro mais os primeiros minutos do dia do proprio nome. Por isso
#    a janela de arquivos vai de START ate END+1.
#
#    A selecao por nome e so otimizacao: o filtro fino e por conteudo, no awk.
#    Se a rotacao atrasar ou falhar num dia, a busca continua correta.
# -----------------------------------------------------------------------------
declare -a FILES=()
declare -A SEEN=()

_add_file() {
    [[ -f "$1" ]] || return 0
    [[ -n "${SEEN[$1]:-}" ]] && return 0
    SEEN[$1]=1
    FILES+=("$1")
}

cursor="$START_DATE"
lim_num=$(date -d "$END_DATE +1 day" +%Y%m%d)
while :; do
    suf=$(date -d "$cursor" +%Y%m%d)
    (( 10#$suf > 10#$lim_num )) && break
    for h in "${HOSTS[@]}"; do
        _add_file "${BASE_LOG_DIR}/${h}.log-${suf}"
        _add_file "${BASE_LOG_DIR}/${h}.log-${suf}.gz"
    done
    cursor=$(date -d "$cursor +1 day" +%Y-%m-%d)
done

# O arquivo vivo sempre entra: ainda nao rotacionou, entao pode conter o periodo.
for h in "${HOSTS[@]}"; do
    _add_file "${BASE_LOG_DIR}/${h}.log"
done

if [[ ${#FILES[@]} -eq 0 ]]; then
    # Sempre avisa, inclusive pela via web: "nao existe log do periodo" e uma
    # resposta diferente de "nao houve alocacao", e quem responde oficio precisa
    # conseguir distinguir as duas.
    echo -e "${RED}Nenhum arquivo de log cobre o periodo ${START_DATE} a ${END_DATE}" \
            "para a(s) caixa(s): ${HOSTS[*]}.${NC}" >&2
    exit 1
fi

if [[ $INTERACTIVE -eq 1 ]]; then
    echo ""
    echo -e "${YELLOW}>>> ${#FILES[@]} arquivo(s) na janela, ${#HOSTS[@]} caixa(s).${NC}"
    echo -e "${YELLOW}>>> INICIANDO BUSCA...${NC}"
    printf "%-26s %-16s %-16s %-16s %s\n" "Data/Hora" "IP Privado" "IP Publico" "Range" "Caixa"
    echo "--------------------------------------------------------------------------------------------"
fi

# -----------------------------------------------------------------------------
# 5. Busca
# -----------------------------------------------------------------------------
for LOG_FILE in "${FILES[@]}"; do
    fname=$(basename "$LOG_FILE")
    host_label="${fname%%.log*}"

    # O ano so precisa ser inferido no formato syslog tradicional, que nao o
    # carrega. Ele vem do NOME DO ARQUIVO, nunca da data da busca: usar a data
    # da busca faz toda consulta que cruza o ano-novo devolver vazio.
    if [[ "$fname" =~ \.log-([0-9]{4})([0-9]{2})[0-9]{2} ]]; then
        year_ref="${BASH_REMATCH[1]}"
        file_month="${BASH_REMATCH[2]}"
    else
        year_ref=$(date +%Y)
        file_month=""
    fi

    # zgrep le .gz e texto puro; -F trata o IP como literal, nao como regex
    # (os pontos casariam com qualquer caractere).
    zgrep -aF -e "$TARGET_IP" "$LOG_FILE" 2>/dev/null |
        "$AWK_BIN" -v start_date="$START_DATE" \
                   -v end_date="$END_DATE" \
                   -v t_port="$TARGET_PORT" \
                   -v t_ip="$TARGET_IP" \
                   -v year_ref="$year_ref" \
                   -v file_month="$file_month" \
                   -v host_label="$host_label" '
    BEGIN {
        m["Jan"]="01"; m["Feb"]="02"; m["Mar"]="03"; m["Apr"]="04";
        m["May"]="05"; m["Jun"]="06"; m["Jul"]="07"; m["Aug"]="08";
        m["Sep"]="09"; m["Oct"]="10"; m["Nov"]="11"; m["Dec"]="12";
    }
    {
        if ($1 ~ /^[0-9][0-9][0-9][0-9]-/) {
            # RSYSLOG_FileFormat: 2026-01-19T14:22:01.482301-03:00
            line_date = substr($1, 1, 10)
            full_ts = $1
            sub(/\..*$/, "", full_ts)
            gsub(/T/, " ", full_ts)
        } else {
            mes_num = m[$1]
            if (mes_num == "") next
            dia_num = sprintf("%02d", $2)
            yr = year_ref + 0
            # Arquivo rotacionado em janeiro carrega o 31/dez do ano anterior.
            if (file_month != "" && (mes_num + 0) > (file_month + 0)) yr = yr - 1
            line_date = yr "-" mes_num "-" dia_num
            full_ts = line_date " " $3
        }

        if (line_date < start_date || line_date > end_date) next

        if (match($0, /([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+) -> ([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+):([0-9]+),([0-9]+)/, arr)) {
            priv_ip = arr[1]
            pub_ip  = arr[2]
            p_start = arr[3] + 0
            p_end   = arr[4] + 0

            if (pub_ip != t_ip) next

            if (t_port != "") {
                p = t_port + 0
                if (p < p_start || p > p_end) next
            }

            printf "%-26s \033[0;32m%-16s\033[0m %-16s %-16s %s\n", \
                   full_ts, priv_ip, pub_ip, p_start "-" p_end, host_label
        }
    }'
done

if [[ $INTERACTIVE -eq 1 ]]; then
    echo -e "${BLUE}================================================================${NC}"
    echo -e "Busca finalizada."
fi
HUNTEREOF

    sed -i "s|@@LOG_DIR@@|${syslog_log_dir}|g" "$SYSLOG_HUNTER_BIN"
    chmod 0755 "$SYSLOG_HUNTER_BIN"
    chown root:root "$SYSLOG_HUNTER_BIN"
    return 0
}

