fn_snmpwalk() {
    which snmpwalk &>/dev/null || apt-get install -y snmp

    versao=$(whiptail --title "SNMPwalk - Versao" \
        --menu "Selecione a versao SNMP:" 10 50 2 \
        "1" "v1" \
        "2" "v2c" \
        3>&1 1>&2 2>&3)
    [[ $? -ne 0 ]] && return 1

    local snmp_ver
    [[ "$versao" == "1" ]] && snmp_ver="1" || snmp_ver="2c"

    ip_alvo=$(whiptail --title "SNMPwalk - IP" \
        --inputbox "IP do dispositivo alvo:" 8 50 \
        3>&1 1>&2 2>&3)
    [[ $? -ne 0 || -z "$ip_alvo" ]] && return 1

    local snmp_conf="/etc/hub-automacoes/snmp.conf"
    local comm=""
    declare -a saved_names=()
    declare -a saved_values=()

    if [[ -r "$snmp_conf" ]]; then
        while IFS='=' read -r key val; do
            [[ -z "$key" || "$key" =~ ^[[:space:]]*# ]] && continue
            key="${key## }"; key="${key%% }"
            val="${val## }"; val="${val%% }"
            [[ -z "$key" || -z "$val" ]] && continue
            saved_names+=("$key")
            saved_values+=("$val")
        done < "$snmp_conf"
    fi

    if [[ ${#saved_names[@]} -gt 0 ]]; then
        local menu_opts=()
        local i
        for ((i=0; i<${#saved_names[@]}; i++)); do
            menu_opts+=("$((i+1))" "${saved_names[$i]}")
        done
        local manual_idx=$(( ${#saved_names[@]} + 1 ))
        menu_opts+=("$manual_idx" "Digitar manualmente")

        local escolha
        escolha=$(whiptail --title "SNMPwalk - Community" \
            --menu "Selecione a community:" 16 60 8 \
            "${menu_opts[@]}" \
            3>&1 1>&2 2>&3)
        [[ $? -ne 0 ]] && return 1

        if [[ "$escolha" == "$manual_idx" ]]; then
            comm=$(whiptail --title "SNMPwalk - Community" \
                --passwordbox "Digite a community:" 8 60 \
                3>&1 1>&2 2>&3)
            [[ $? -ne 0 || -z "$comm" ]] && return 1
        else
            comm="${saved_values[$((escolha - 1))]}"
        fi
    else
        comm=$(whiptail --title "SNMPwalk - Community" \
            --passwordbox "Digite a community:\n\nPara salvar communities de uso frequente, crie:\n  ${snmp_conf}\nFormato: NOME=valor (uma por linha)\nAjuste permissoes: chmod 600" 14 70 \
            3>&1 1>&2 2>&3)
        [[ $? -ne 0 || -z "$comm" ]] && return 1
    fi

    oid=$(whiptail --title "SNMPwalk - OID" \
        --inputbox "OID (deixe vazio para consultar tudo):" 8 60 \
        3>&1 1>&2 2>&3)

    local cmd_args=(snmpwalk "-v$snmp_ver" -c "$comm" "$ip_alvo")
    [[ -n "$oid" ]] && cmd_args+=("$oid")

    whiptail --title "SNMPwalk" --msgbox "Executando consulta. O resultado sera exibido no terminal.\n\nComando: snmpwalk -v$snmp_ver -c *** $ip_alvo ${oid}" 10 70

    "${cmd_args[@]}"

    whiptail --title "SNMPwalk" --msgbox "Consulta finalizada. Pressione Ok para voltar ao menu." 8 55
}

