_syslog_firewall() {
    if [[ ${#syslog_origens[@]} -eq 0 ]]; then
        return 0
    fi

    if ! systemctl is-active --quiet netfilter-persistent 2>/dev/null &&
       ! iptables -L INPUT -n 2>/dev/null | grep -q "DROP\|REJECT"; then
        whiptail --title "Syslog CGNAT - Firewall" --msgbox \
"Nenhum firewall ativo detectado. As regras de liberacao da porta ${syslog_porta}/udp nao foram aplicadas.

Use 'Firewall e Rede' no menu principal para montar o ruleset e depois reaplique." 12 68
        return 0
    fi

    local src
    for src in "${syslog_origens[@]}"; do
        if [[ "$src" == *:* ]]; then
            ip6tables -A INPUT -p udp -s "$src" --dport "$syslog_porta" -j ACCEPT
        else
            iptables  -A INPUT -p udp -s "$src" --dport "$syslog_porta" -j ACCEPT
        fi
    done

    netfilter-persistent save >/dev/null 2>&1
    _hub_log INFO "syslog: liberadas ${#syslog_origens[@]} origem(ns) na porta ${syslog_porta}/udp"
    return 0
}

fn_syslog_cgnat() {
    _syslog_coletar_dados || return 1

    local resumo="Confirma a instalacao do kit?\n\n"
    resumo+="  Diretorio:      ${syslog_log_dir}\n"
    resumo+="  Retencao:       ${syslog_retencao} dias\n"
    resumo+="  Porta:          ${syslog_porta}/udp\n"
    resumo+="  Origens:        ${#syslog_origens[@]}\n"
    resumo+="  Banco + web:    ${syslog_usar_db}\n"
    [[ "$syslog_usar_db" == "yes" ]] && resumo+="  Retencao banco: ${syslog_db_retencao} dias\n"
    resumo+="  Usuario web:    ${syslog_web_user}\n"

    whiptail --title "Syslog CGNAT - Confirmacao" --yesno "$resumo" 18 66 || return 1

    _hub_log INFO "syslog: iniciando instalacao do kit (db=${syslog_usar_db})"

    # O banco vem antes do rsyslog: a action ommysql da config aponta para o
    # usuario 'rsyslog', que precisa existir antes do servico subir.
    _syslog_instalar_pacotes    || return 1
    _syslog_config_mariadb      || return 1
    _syslog_config_rsyslog      || return 1
    _syslog_config_logrotate    || return 1
    _syslog_instalar_hunter     || return 1
    _syslog_instalar_web_hunter || return 1
    _syslog_instalar_loganalyzer || true
    _syslog_firewall

    detectar_ips
    local ip_acesso="${ipv4_list[0]:-<ip-do-servidor>}"

    local final="Kit syslog CGNAT instalado.\n\n"
    final+="Coleta:    ${syslog_porta}/udp -> ${syslog_log_dir}/<host>.log\n"
    final+="Rotacao:   diaria, ${syslog_retencao} dias, comprimida\n"
    final+="Hunter:    http://${ip_acesso}/cgnat_hunter/\n"
    final+="CLI:       ${SYSLOG_HUNTER_BIN}\n"
    [[ "$syslog_usar_db" == "yes" ]] && final+="LogAnalyzer: http://${ip_acesso}/logs/\n"
    final+="\nAuditoria de consultas: ${SYSLOG_AUDIT_LOG}\n"
    [[ "$syslog_usar_db" == "yes" ]] && final+="Senha do banco: ${HUB_CRED_DIR}/syslog/mariadb.cred\n"

    whiptail --title "Concluido" --msgbox "$final" 20 72
    _hub_log INFO "syslog: kit instalado com sucesso"
    return 0
}

